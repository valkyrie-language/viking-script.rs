{
    "name": "viking-compiler",
    "version": "0.1.0",
    "description": "Viking Script Compiler",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "vite build",
        "build:tsc": "tsc",
        "dev": "vite build --watch",
        "test": "vitest",
        "test:compiler": "npm run build:tsc && node dist/test/test-compiler.js",
        "clean": "rimraf dist",
        "compile-example": "npm run build:tsc && node -e \"const {compileFile} = require('./dist'); const fs = require('fs'); const result = compileFile('tests/simple.viking', fs.readFileSync('test/simple.viking', 'utf-8')); console.log(result.code);\"",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write src/**/*.ts"
    },
    "keywords": [
        "compiler",
        "language",
        "typescript",
        "javascript",
        "viking",
        "cps",
        "algebraic-effects"
    ],
    "author": "Viking Script Team",
    "license": "MIT",
    "dependencies": {
        "source-map": "^0.7.4",
        "viking-parser": "workspace:*",
        "viking-runtime": "workspace:*",
        "viking-hir": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "@types/node": "^20.0.0",
        "@types/source-map": "^0.5.7",
        "vite": "^5.0.0",
        "vitest": "^1.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "nodemon": "^3.0.0",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.0"
    },
    "engines": {
        "node": ">=16.0.0"
    }
}